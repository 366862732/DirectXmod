// d3d12bridge.cpp - ??????
#include <jni.h>
#include <windows.h>
#include <d3d12.h>
#include <dxgi1_6.h>
#include <d3dcompiler.h>
#include <iostream>
#include <unordered_map>
#include <vector>
#include <string>
#include <cstring>

#pragma comment(lib, "d3d12.lib")
#pragma comment(lib, "dxgi.lib")
#pragma comment(lib, "d3dcompiler.lib")

#define SAFE_RELEASE(p) { if(p) { (p)->Release(); (p)=nullptr; } }

struct Texture {
    ID3D12Resource* resource = nullptr;
    int width = 0, height = 0;
    bool isValid = false;
};

struct Buffer {
    ID3D12Resource* resource = nullptr;
    int size = 0;
    D3D12_GPU_VIRTUAL_ADDRESS gpuAddress = 0;
    bool isValid = false;
};

struct Shader {
    std::vector<uint8_t> bytecode;
    int type = 0;
    bool compiled = false;
};

struct Program {
    ID3D12PipelineState* pso = nullptr;
    ID3D12RootSignature* rootSignature = nullptr;
    int vsId = 0, fsId = 0;
    bool linked = false;
};

class D3D12Renderer {
public:
    static D3D12Renderer& get() {
        static D3D12Renderer instance;
        return instance;
    }

    bool init(HWND hwnd, int width, int height) {
        m_hwnd = hwnd;
        m_width = width;
        m_height = height;
        
        if (!initDevice()) return false;
        if (!initCommandQueue()) return false;
        if (!initDescriptorHeaps()) return false;
        if (!initSwapChain()) return false;
        if (!initRootSignature()) return false;
        
        std::cout << "[DX12] Initialized successfully" << std::endl;
        return true;
    }

    void shutdown() {
        waitForGPU();
        for (auto& pair : m_textures) if (pair.second.resource) pair.second.resource->Release();
        for (auto& pair : m_buffers) if (pair.second.resource) pair.second.resource->Release();
        for (auto& pair : m_pipelines) {
            if (pair.second.pso) pair.second.pso->Release();
            if (pair.second.rootSignature) pair.second.rootSignature->Release();
        }
        SAFE_RELEASE(m_commandList);
        SAFE_RELEASE(m_commandAllocator);
        SAFE_RELEASE(m_swapChain);
        SAFE_RELEASE(m_commandQueue);
        SAFE_RELEASE(m_rtvHeap);
        SAFE_RELEASE(m_srvHeap);
        SAFE_RELEASE(m_rootSignature);
        SAFE_RELEASE(m_fence);
        SAFE_RELEASE(m_device);
        if (m_fenceEvent) CloseHandle(m_fenceEvent);
        std::cout << "[DX12] Shutdown" << std::endl;
    }

    void resize(int width, int height) {
        if (m_width == width && m_height == height) return;
        waitForGPU();
        m_width = width;
        m_height = height;
        if (m_swapChain) {
            m_swapChain->ResizeBuffers(2, width, height, DXGI_FORMAT_R8G8B8A8_UNORM, 0);
            D3D12_CPU_DESCRIPTOR_HANDLE rtvHandle = m_rtvHeap->GetCPUDescriptorHandleForHeapStart();
            for (int i = 0; i < 2; i++) {
                ID3D12Resource* buffer = nullptr;
                m_swapChain->GetBuffer(i, IID_PPV_ARGS(&buffer));
                m_device->CreateRenderTargetView(buffer, nullptr, rtvHandle);
                buffer->Release();
                rtvHandle.ptr += m_rtvDescriptorSize;
            }
        }
    }

    void beginFrame() {
        if (!m_commandAllocator || !m_commandList) return;
        m_commandAllocator->Reset();
        m_commandList->Reset(m_commandAllocator, nullptr);
        
        ID3D12DescriptorHeap* heaps[] = { m_srvHeap };
        m_commandList->SetDescriptorHeaps(1, heaps);
        
        ID3D12Resource* backBuffer = nullptr;
        m_swapChain->GetBuffer(m_currentBackBuffer, IID_PPV_ARGS(&backBuffer));
        
        D3D12_RESOURCE_BARRIER barrier = {};
        barrier.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
        barrier.Transition.pResource = backBuffer;
        barrier.Transition.StateBefore = D3D12_RESOURCE_STATE_PRESENT;
        barrier.Transition.StateAfter = D3D12_RESOURCE_STATE_RENDER_TARGET;
        barrier.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
        m_commandList->ResourceBarrier(1, &barrier);
        
        D3D12_CPU_DESCRIPTOR_HANDLE rtvHandle = m_rtvHeap->GetCPUDescriptorHandleForHeapStart();
        rtvHandle.ptr += m_currentBackBuffer * m_rtvDescriptorSize;
        m_commandList->OMSetRenderTargets(1, &rtvHandle, FALSE, nullptr);
        m_commandList->ClearRenderTargetView(rtvHandle, m_clearColor, 0, nullptr);
        
        D3D12_VIEWPORT viewport = { 0.0f, 0.0f, (float)m_width, (float)m_height, 0.0f, 1.0f };
        m_commandList->RSSetViewports(1, &viewport);
        D3D12_RECT scissorRect = { 0, 0, m_width, m_height };
        m_commandList->RSSetScissorRects(1, &scissorRect);
        
        if (m_rootSignature) m_commandList->SetGraphicsRootSignature(m_rootSignature);
        backBuffer->Release();
    }

    void endFrame() {
        if (!m_commandList || !m_swapChain) return;
        ID3D12Resource* backBuffer = nullptr;
        m_swapChain->GetBuffer(m_currentBackBuffer, IID_PPV_ARGS(&backBuffer));
        D3D12_RESOURCE_BARRIER barrier = {};
        barrier.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
        barrier.Transition.pResource = backBuffer;
        barrier.Transition.StateBefore = D3D12_RESOURCE_STATE_RENDER_TARGET;
        barrier.Transition.StateAfter = D3D12_RESOURCE_STATE_PRESENT;
        barrier.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
        m_commandList->ResourceBarrier(1, &barrier);
        backBuffer->Release();
        m_commandList->Close();
        ID3D12CommandList* lists[] = { m_commandList };
        m_commandQueue->ExecuteCommandLists(1, lists);
    }

    void present() {
        if (m_swapChain) {
            m_swapChain->Present(1, 0);
            m_currentBackBuffer = m_swapChain->GetCurrentBackBufferIndex();
            waitForGPU();
        }
    }

    int createTexture() { int id = ++m_nextTextureId; m_textures[id] = Texture{}; std::cout << "[DX12] Created texture: " << id << std::endl; return id; }
    void deleteTexture(int id) { auto it = m_textures.find(id); if (it != m_textures.end()) { if (it->second.resource) it->second.resource->Release(); m_textures.erase(it); std::cout << "[DX12] Deleted texture: " << id << std::endl; } }
    void bindTexture(int target, int id) { m_currentTexture = id; std::cout << "[DX12] Bind texture: target=" << target << ", id=" << id << std::endl; }
    
    void uploadTextureData(int id, int width, int height, const void* data) {
        auto it = m_textures.find(id);
        if (it == m_textures.end() || !data || width == 0 || height == 0) return;
        D3D12_RESOURCE_DESC texDesc = {};
        texDesc.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
        texDesc.Width = width; texDesc.Height = height; texDesc.DepthOrArraySize = 1; texDesc.MipLevels = 1;
        texDesc.Format = DXGI_FORMAT_R8G8B8A8_UNORM; texDesc.SampleDesc.Count = 1; texDesc.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
        D3D12_HEAP_PROPERTIES defaultProps = {}; defaultProps.Type = D3D12_HEAP_TYPE_DEFAULT;
        ID3D12Resource* texture = nullptr;
        HRESULT hr = m_device->CreateCommittedResource(&defaultProps, D3D12_HEAP_FLAG_NONE, &texDesc, D3D12_RESOURCE_STATE_COPY_DEST, nullptr, IID_PPV_ARGS(&texture));
        if (FAILED(hr)) return;
        UINT64 uploadSize = 0; m_device->GetCopyableFootprints(&texDesc, 0, 1, 0, nullptr, nullptr, nullptr, &uploadSize);
        D3D12_HEAP_PROPERTIES uploadProps = {}; uploadProps.Type = D3D12_HEAP_TYPE_UPLOAD;
        D3D12_RESOURCE_DESC bufferDesc = {}; bufferDesc.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; bufferDesc.Width = uploadSize; bufferDesc.Height = 1; bufferDesc.DepthOrArraySize = 1; bufferDesc.MipLevels = 1; bufferDesc.Format = DXGI_FORMAT_UNKNOWN; bufferDesc.SampleDesc.Count = 1; bufferDesc.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
        ID3D12Resource* uploadBuffer = nullptr;
        hr = m_device->CreateCommittedResource(&uploadProps, D3D12_HEAP_FLAG_NONE, &bufferDesc, D3D12_RESOURCE_STATE_GENERIC_READ, nullptr, IID_PPV_ARGS(&uploadBuffer));
        if (FAILED(hr)) { texture->Release(); return; }
        void* mapped = nullptr; uploadBuffer->Map(0, nullptr, &mapped); memcpy(mapped, data, width * height * 4); uploadBuffer->Unmap(0, nullptr);
        ID3D12CommandAllocator* tempAllocator = nullptr; ID3D12GraphicsCommandList* tempCmdList = nullptr;
        m_device->CreateCommandAllocator(D3D12_COMMAND_LIST_TYPE_DIRECT, IID_PPV_ARGS(&tempAllocator));
        m_device->CreateCommandList(0, D3D12_COMMAND_LIST_TYPE_DIRECT, tempAllocator, nullptr, IID_PPV_ARGS(&tempCmdList));
        D3D12_TEXTURE_COPY_LOCATION dstLoc = {}; dstLoc.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX; dstLoc.pResource = texture; dstLoc.SubresourceIndex = 0;
        D3D12_TEXTURE_COPY_LOCATION srcLoc = {}; srcLoc.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT; srcLoc.pResource = uploadBuffer;
        srcLoc.PlacedFootprint.Footprint.Format = texDesc.Format; srcLoc.PlacedFootprint.Footprint.Width = width; srcLoc.PlacedFootprint.Footprint.Height = height; srcLoc.PlacedFootprint.Footprint.Depth = 1; srcLoc.PlacedFootprint.Footprint.RowPitch = width * 4;
        tempCmdList->CopyTextureRegion(&dstLoc, 0, 0, 0, &srcLoc, nullptr);
        tempCmdList->Close();
        ID3D12CommandList* lists[] = { tempCmdList };
        m_commandQueue->ExecuteCommandLists(1, lists);
        waitForGPU();
        SAFE_RELEASE(tempCmdList); SAFE_RELEASE(tempAllocator); SAFE_RELEASE(uploadBuffer);
        if (it->second.resource) it->second.resource->Release();
        it->second.resource = texture; it->second.width = width; it->second.height = height; it->second.isValid = true;
        D3D12_SHADER_RESOURCE_VIEW_DESC srvDesc = {}; srvDesc.Format = texDesc.Format; srvDesc.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D; srvDesc.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING; srvDesc.Texture2D.MipLevels = 1;
        D3D12_CPU_DESCRIPTOR_HANDLE srvHandle = m_srvHeap->GetCPUDescriptorHandleForHeapStart(); srvHandle.ptr += (id - 1) * m_srvDescriptorSize;
        m_device->CreateShaderResourceView(texture, &srvDesc, srvHandle);
        std::cout << "[DX12] Texture " << id << " uploaded: " << width << "x" << height << std::endl;
    }

    int createBuffer() { int id = ++m_nextBufferId; m_buffers[id] = Buffer{}; std::cout << "[DX12] Created buffer: " << id << std::endl; return id; }
    void deleteBuffer(int id) { auto it = m_buffers.find(id); if (it != m_buffers.end()) { if (it->second.resource) it->second.resource->Release(); m_buffers.erase(it); std::cout << "[DX12] Deleted buffer: " << id << std::endl; } }
    void bindBuffer(int target, int id) { if (target == 34962) m_currentVertexBuffer = id; if (target == 34963) m_currentIndexBuffer = id; std::cout << "[DX12] Bind buffer: target=" << target << ", id=" << id << std::endl; }
    
    void uploadBufferData(int id, const void* data, int size) {
        auto it = m_buffers.find(id);
        if (it == m_buffers.end() || !data || size == 0) return;
        D3D12_HEAP_PROPERTIES uploadProps = {}; uploadProps.Type = D3D12_HEAP_TYPE_UPLOAD;
        D3D12_RESOURCE_DESC bufferDesc = {}; bufferDesc.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; bufferDesc.Width = size; bufferDesc.Height = 1; bufferDesc.DepthOrArraySize = 1; bufferDesc.MipLevels = 1; bufferDesc.Format = DXGI_FORMAT_UNKNOWN; bufferDesc.SampleDesc.Count = 1; bufferDesc.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
        ID3D12Resource* uploadBuffer = nullptr;
        HRESULT hr = m_device->CreateCommittedResource(&uploadProps, D3D12_HEAP_FLAG_NONE, &bufferDesc, D3D12_RESOURCE_STATE_GENERIC_READ, nullptr, IID_PPV_ARGS(&uploadBuffer));
        if (FAILED(hr)) return;
        void* mapped = nullptr; uploadBuffer->Map(0, nullptr, &mapped); memcpy(mapped, data, size); uploadBuffer->Unmap(0, nullptr);
        if (it->second.resource) it->second.resource->Release();
        it->second.resource = uploadBuffer; it->second.size = size; it->second.gpuAddress = uploadBuffer->GetGPUVirtualAddress(); it->second.isValid = true;
        std::cout << "[DX12] Buffer " << id << " uploaded: " << size << " bytes" << std::endl;
    }

    int createProgram() { int id = ++m_nextProgramId; m_pipelines[id] = Program{}; std::cout << "[DX12] Created program: " << id << std::endl; return id; }
    int createShader(int type) { int id = ++m_nextShaderId; Shader shader; shader.type = type; m_shaders[id] = shader; std::cout << "[DX12] Created shader: type=" << type << ", id=" << id << std::endl; return id; }
    
    void shaderSource(int shaderId, const std::string& source) {
        auto it = m_shaders.find(shaderId);
        if (it == m_shaders.end()) return;
        std::string hlsl;
        if (it->second.type == 35633) {
            hlsl = "struct VSInput { float4 position : POSITION; };\n"
                   "struct VSOutput { float4 position : SV_POSITION; };\n"
                   "VSOutput main(VSInput input) { VSOutput output; output.position = input.position; return output; }\n";
        } else {
            hlsl = "float4 main() : SV_TARGET { return float4(0.4f, 0.6f, 1.0f, 1.0f); }\n";
        }
        UINT flags = D3DCOMPILE_OPTIMIZATION_LEVEL3;
        const char* target = (it->second.type == 35633) ? "vs_5_0" : "ps_5_0";
        ID3DBlob* shaderBlob = nullptr; ID3DBlob* errorBlob = nullptr;
        HRESULT hr = D3DCompile(hlsl.c_str(), hlsl.length(), nullptr, nullptr, nullptr, "main", target, flags, 0, &shaderBlob, &errorBlob);
        if (FAILED(hr)) { if (errorBlob) { std::cout << "[DX12] Shader compile error: " << (char*)errorBlob->GetBufferPointer() << std::endl; errorBlob->Release(); } return; }
        it->second.bytecode.assign((uint8_t*)shaderBlob->GetBufferPointer(), (uint8_t*)shaderBlob->GetBufferPointer() + shaderBlob->GetBufferSize());
        it->second.compiled = true; shaderBlob->Release(); if (errorBlob) errorBlob->Release();
        std::cout << "[DX12] Shader " << shaderId << " compiled" << std::endl;
    }

    void attachShader(int programId, int shaderId) {
        auto progIt = m_pipelines.find(programId); auto shadIt = m_shaders.find(shaderId);
        if (progIt == m_pipelines.end() || shadIt == m_shaders.end()) return;
        if (shadIt->second.type == 35633) progIt->second.vsId = shaderId;
        else progIt->second.fsId = shaderId;
        std::cout << "[DX12] Attached shader " << shaderId << " to program " << programId << std::endl;
    }

    void linkProgram(int programId) {
        auto it = m_pipelines.find(programId);
        if (it == m_pipelines.end()) return;
        auto vsIt = m_shaders.find(it->second.vsId); auto fsIt = m_shaders.find(it->second.fsId);
        if (vsIt == m_shaders.end() || fsIt == m_shaders.end() || !vsIt->second.compiled || !fsIt->second.compiled) {
            std::cout << "[DX12] Link program " << programId << " failed" << std::endl; return;
        }
        D3D12_GRAPHICS_PIPELINE_STATE_DESC psoDesc = {};
        psoDesc.InputLayout = { nullptr, 0 };
        psoDesc.pRootSignature = m_rootSignature;
        psoDesc.VS = { vsIt->second.bytecode.data(), vsIt->second.bytecode.size() };
        psoDesc.PS = { fsIt->second.bytecode.data(), fsIt->second.bytecode.size() };
        psoDesc.RasterizerState.FillMode = D3D12_FILL_MODE_SOLID; psoDesc.RasterizerState.CullMode = D3D12_CULL_MODE_BACK;
        psoDesc.RasterizerState.FrontCounterClockwise = FALSE; psoDesc.RasterizerState.DepthClipEnable = TRUE;
        psoDesc.BlendState.AlphaToCoverageEnable = FALSE; psoDesc.BlendState.IndependentBlendEnable = FALSE;
        psoDesc.BlendState.RenderTarget[0].BlendEnable = FALSE; psoDesc.BlendState.RenderTarget[0].RenderTargetWriteMask = D3D12_COLOR_WRITE_ENABLE_ALL;
        psoDesc.DepthStencilState.DepthEnable = FALSE;
        psoDesc.SampleMask = UINT_MAX; psoDesc.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
        psoDesc.NumRenderTargets = 1; psoDesc.RTVFormats[0] = DXGI_FORMAT_R8G8B8A8_UNORM; psoDesc.SampleDesc.Count = 1;
        HRESULT hr = m_device->CreateGraphicsPipelineState(&psoDesc, IID_PPV_ARGS(&it->second.pso));
        if (SUCCEEDED(hr)) { it->second.linked = true; std::cout << "[DX12] Program " << programId << " linked" << std::endl; }
        else std::cout << "[DX12] Failed to create PSO for program " << programId << std::endl;
    }

    void useProgram(int programId) { m_currentProgram = programId; auto it = m_pipelines.find(programId); if (it != m_pipelines.end() && it->second.pso) m_commandList->SetPipelineState(it->second.pso); std::cout << "[DX12] Use program: " << programId << std::endl; }

    void drawElements(int mode, int count, int type, long indices) {
        std::cout << "[DX12] drawElements: mode=" << mode << ", count=" << count << std::endl;
        if (!m_commandList) { std::cout << "[DX12] ERROR: m_commandList is NULL" << std::endl; return; }
        auto vbufIt = m_buffers.find(m_currentVertexBuffer);
        if (vbufIt != m_buffers.end() && vbufIt->second.resource) {
            D3D12_VERTEX_BUFFER_VIEW vbv = {}; vbv.BufferLocation = vbufIt->second.gpuAddress; vbv.SizeInBytes = vbufIt->second.size; vbv.StrideInBytes = 32;
            m_commandList->IASetVertexBuffers(0, 1, &vbv);
            std::cout << "[DX12] Vertex buffer set, id=" << m_currentVertexBuffer << ", size=" << vbufIt->second.size << std::endl;
        } else { std::cout << "[DX12] WARNING: No valid vertex buffer, id=" << m_currentVertexBuffer << std::endl; }
        auto ibufIt = m_buffers.find(m_currentIndexBuffer);
        if (ibufIt != m_buffers.end() && ibufIt->second.resource) {
            D3D12_INDEX_BUFFER_VIEW ibv = {}; ibv.BufferLocation = ibufIt->second.gpuAddress; ibv.SizeInBytes = ibufIt->second.size; ibv.Format = DXGI_FORMAT_R32_UINT;
            m_commandList->IASetIndexBuffer(&ibv);
            std::cout << "[DX12] Index buffer set, id=" << m_currentIndexBuffer << ", size=" << ibufIt->second.size << std::endl;
        } else { std::cout << "[DX12] No index buffer" << std::endl; }
        m_commandList->IASetPrimitiveTopology(D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
        if (ibufIt != m_buffers.end() && ibufIt->second.resource) m_commandList->DrawIndexedInstanced(count, 1, 0, 0, 0);
        else m_commandList->DrawInstanced(count, 1, 0, 0);
        std::cout << "[DX12] drawElements executed" << std::endl;
    }

    void drawArrays(int mode, int first, int count) {
        std::cout << "[DX12] drawArrays: mode=" << mode << ", count=" << count << std::endl;
        if (!m_commandList) return;
        auto vbufIt = m_buffers.find(m_currentVertexBuffer);
        if (vbufIt != m_buffers.end() && vbufIt->second.resource) {
            D3D12_VERTEX_BUFFER_VIEW vbv = {}; vbv.BufferLocation = vbufIt->second.gpuAddress; vbv.SizeInBytes = vbufIt->second.size; vbv.StrideInBytes = 32;
            m_commandList->IASetVertexBuffers(0, 1, &vbv);
        }
        m_commandList->IASetPrimitiveTopology(D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
        m_commandList->DrawInstanced(count, 1, first, 0);
    }

    void setViewport(int x, int y, int width, int height) { if (m_commandList) { D3D12_VIEWPORT vp = { (float)x, (float)y, (float)width, (float)height, 0.0f, 1.0f }; m_commandList->RSSetViewports(1, &vp); } }
    void setClearColor(float r, float g, float b, float a) { m_clearColor[0] = r; m_clearColor[1] = g; m_clearColor[2] = b; m_clearColor[3] = a; }
    int getCurrentTexture() const { return m_currentTexture; }
    int getCurrentVertexBuffer() const { return m_currentVertexBuffer; }
    int getCurrentProgram() const { return m_currentProgram; }

private:
    D3D12Renderer() = default;
    ~D3D12Renderer() { shutdown(); }

    bool initDevice() {
#ifdef _DEBUG
        ID3D12Debug* debugController = nullptr;
        if (SUCCEEDED(D3D12GetDebugInterface(IID_PPV_ARGS(&debugController)))) { debugController->EnableDebugLayer(); debugController->Release(); std::cout << "[DX12] Debug layer enabled" << std::endl; }
#endif
        HRESULT hr = D3D12CreateDevice(nullptr, D3D_FEATURE_LEVEL_11_0, IID_PPV_ARGS(&m_device));
        if (FAILED(hr)) {
            IDXGIFactory4* factory = nullptr;
            if (SUCCEEDED(CreateDXGIFactory1(IID_PPV_ARGS(&factory)))) {
                IDXGIAdapter* warp = nullptr; factory->EnumWarpAdapter(IID_PPV_ARGS(&warp));
                hr = D3D12CreateDevice(warp, D3D_FEATURE_LEVEL_11_0, IID_PPV_ARGS(&m_device)); warp->Release(); factory->Release();
            }
        }
        if (FAILED(hr)) return false;
        return true;
    }

    bool initCommandQueue() {
        D3D12_COMMAND_QUEUE_DESC queueDesc = {}; queueDesc.Type = D3D12_COMMAND_LIST_TYPE_DIRECT;
        HRESULT hr = m_device->CreateCommandQueue(&queueDesc, IID_PPV_ARGS(&m_commandQueue)); if (FAILED(hr)) return false;
        hr = m_device->CreateCommandAllocator(D3D12_COMMAND_LIST_TYPE_DIRECT, IID_PPV_ARGS(&m_commandAllocator)); if (FAILED(hr)) return false;
        hr = m_device->CreateCommandList(0, D3D12_COMMAND_LIST_TYPE_DIRECT, m_commandAllocator, nullptr, IID_PPV_ARGS(&m_commandList)); if (FAILED(hr)) return false;
        m_commandList->Close();
        hr = m_device->CreateFence(0, D3D12_FENCE_FLAG_NONE, IID_PPV_ARGS(&m_fence)); if (FAILED(hr)) return false;
        m_fenceEvent = CreateEvent(nullptr, FALSE, FALSE, nullptr);
        return true;
    }

    bool initDescriptorHeaps() {
        D3D12_DESCRIPTOR_HEAP_DESC rtvDesc = {}; rtvDesc.Type = D3D12_DESCRIPTOR_HEAP_TYPE_RTV; rtvDesc.NumDescriptors = 2;
        HRESULT hr = m_device->CreateDescriptorHeap(&rtvDesc, IID_PPV_ARGS(&m_rtvHeap)); if (FAILED(hr)) return false;
        m_rtvDescriptorSize = m_device->GetDescriptorHandleIncrementSize(D3D12_DESCRIPTOR_HEAP_TYPE_RTV);
        D3D12_DESCRIPTOR_HEAP_DESC srvDesc = {}; srvDesc.Type = D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV; srvDesc.NumDescriptors = 1024; srvDesc.Flags = D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE;
        hr = m_device->CreateDescriptorHeap(&srvDesc, IID_PPV_ARGS(&m_srvHeap)); if (FAILED(hr)) return false;
        m_srvDescriptorSize = m_device->GetDescriptorHandleIncrementSize(D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
        return true;
    }

    bool initSwapChain() {
        DXGI_SWAP_CHAIN_DESC1 desc = {}; desc.BufferCount = 2; desc.Width = m_width; desc.Height = m_height; desc.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
        desc.BufferUsage = DXGI_USAGE_RENDER_TARGET_OUTPUT; desc.SwapEffect = DXGI_SWAP_EFFECT_FLIP_DISCARD; desc.SampleDesc.Count = 1;
        IDXGIFactory4* factory = nullptr; HRESULT hr = CreateDXGIFactory1(IID_PPV_ARGS(&factory)); if (FAILED(hr)) return false;
        IDXGISwapChain1* swapChain1 = nullptr; hr = factory->CreateSwapChainForHwnd(m_commandQueue, m_hwnd, &desc, nullptr, nullptr, &swapChain1); factory->Release(); if (FAILED(hr)) return false;
        hr = swapChain1->QueryInterface(IID_PPV_ARGS(&m_swapChain)); swapChain1->Release(); if (FAILED(hr)) return false;
        D3D12_CPU_DESCRIPTOR_HANDLE rtvHandle = m_rtvHeap->GetCPUDescriptorHandleForHeapStart();
        for (int i = 0; i < 2; i++) { ID3D12Resource* buffer = nullptr; m_swapChain->GetBuffer(i, IID_PPV_ARGS(&buffer)); m_device->CreateRenderTargetView(buffer, nullptr, rtvHandle); buffer->Release(); rtvHandle.ptr += m_rtvDescriptorSize; }
        return true;
    }

    bool initRootSignature() {
        D3D12_ROOT_SIGNATURE_DESC rootSigDesc = {}; rootSigDesc.NumParameters = 0; rootSigDesc.pParameters = nullptr; rootSigDesc.NumStaticSamplers = 0; rootSigDesc.pStaticSamplers = nullptr; rootSigDesc.Flags = D3D12_ROOT_SIGNATURE_FLAG_ALLOW_INPUT_ASSEMBLER_INPUT_LAYOUT;
        ID3DBlob* sigBlob = nullptr; ID3DBlob* errorBlob = nullptr;
        HRESULT hr = D3D12SerializeRootSignature(&rootSigDesc, D3D_ROOT_SIGNATURE_VERSION_1, &sigBlob, &errorBlob); if (FAILED(hr)) return false;
        hr = m_device->CreateRootSignature(0, sigBlob->GetBufferPointer(), sigBlob->GetBufferSize(), IID_PPV_ARGS(&m_rootSignature)); sigBlob->Release(); if (FAILED(hr)) return false;
        return true;
    }

    void waitForGPU() { if (!m_commandQueue || !m_fence || !m_fenceEvent) return; m_fenceValue++; m_commandQueue->Signal(m_fence, m_fenceValue); m_fence->SetEventOnCompletion(m_fenceValue, m_fenceEvent); WaitForSingleObject(m_fenceEvent, INFINITE); }

    ID3D12Device* m_device = nullptr; ID3D12CommandQueue* m_commandQueue = nullptr; ID3D12CommandAllocator* m_commandAllocator = nullptr;
    ID3D12GraphicsCommandList* m_commandList = nullptr; IDXGISwapChain3* m_swapChain = nullptr; ID3D12Fence* m_fence = nullptr;
    HANDLE m_fenceEvent = nullptr; UINT64 m_fenceValue = 0;
    ID3D12DescriptorHeap* m_rtvHeap = nullptr; ID3D12DescriptorHeap* m_srvHeap = nullptr; ID3D12RootSignature* m_rootSignature = nullptr;
    UINT m_rtvDescriptorSize = 0; UINT m_srvDescriptorSize = 0; int m_currentBackBuffer = 0;
    std::unordered_map<int, Texture> m_textures; std::unordered_map<int, Buffer> m_buffers;
    std::unordered_map<int, Shader> m_shaders; std::unordered_map<int, Program> m_pipelines;
    int m_currentTexture = 0; int m_currentVertexBuffer = 0; int m_currentIndexBuffer = 0; int m_currentProgram = 0;
    HWND m_hwnd = nullptr; int m_width = 0, m_height = 0; float m_clearColor[4] = {0.1f, 0.2f, 0.4f, 1.0f};
    int m_nextTextureId = 0; int m_nextBufferId = 0; int m_nextShaderId = 0; int m_nextProgramId = 0;
};

D3D12Renderer& getRenderer() { return D3D12Renderer::get(); }

