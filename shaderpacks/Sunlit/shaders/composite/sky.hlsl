// ---------------------------------------------------------------------------
// 噪声
// ---------------------------------------------------------------------------

float hash12(float2 p)
{
    float3 p3 = frac(p.xyx * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return frac((p3.x + p3.y) * p3.z);
}

float2 hash22(float2 p)
{
    float3 p3 = frac(p.xyx * float3(0.1031, 0.1030, 0.0973));
    p3 += dot(p3, p3.yzx + 33.33);
    return frac((p3.xx + p3.yz) * p3.zy);
}

float vnoise(float2 p)
{
    float2 i = floor(p);
    float2 f = frac(p);
    f = f * f * (3.0 - 2.0 * f);
    float a = hash12(i);
    float b = hash12(i + float2(1.0, 0.0));
    float c = hash12(i + float2(0.0, 1.0));
    float d = hash12(i + float2(1.0, 1.0));
    return lerp(lerp(a, b, f.x), lerp(c, d, f.x), f.y);
}

float fbm(float2 p, int octaves)
{
    float sum = 0.0;
    float amp = 0.5;
    float norm = 0.0;
    for (int i = 0; i < 6; i++)
    {
        if (i >= octaves) break;
        sum += vnoise(p) * amp;
        norm += amp;
        p = p * 2.03 + float2(17.3, 9.1);
        amp *= 0.5;
    }
    return sum / max(norm, 1e-4);
}

// 整数哈希：云噪声专用。云的坐标在千米尺度（乘上 octave 后可达 1e5 格），
// 浮点哈希的 frac/sin 会失去精度，整数格点哈希在大坐标下依然稳定。
float ihash12(int2 p)
{
    uint h = uint(p.x) * 374761393u + uint(p.y) * 668265263u + 1442695041u;
    h = (h ^ (h >> 13u)) * 1274126177u;
    h ^= h >> 16u;
    return float(h & 0xFFFFFFu) * (1.0 / 16777215.0);
}

float ihash13(int3 p)
{
    uint h = uint(p.x) * 374761393u + uint(p.y) * 668265263u + uint(p.z) * 1274126177u;
    h = (h ^ (h >> 13u)) * 1274126177u;
    h ^= h >> 16u;
    return float(h & 0xFFFFFFu) * (1.0 / 16777215.0);
}

// 单位格距值噪声：统计特性对齐 Helian 的 noisetex 采样（1:64 格距等价替换）
float ivnoise2(float2 p)
{
    float2 i = floor(p);
    float2 f = frac(p);
    f = f * f * (3.0 - 2.0 * f);
    int2 ii = int2(i);
    float a = ihash12(ii);
    float b = ihash12(ii + int2(1, 0));
    float c = ihash12(ii + int2(0, 1));
    float d = ihash12(ii + int2(1, 1));
    return lerp(lerp(a, b, f.x), lerp(c, d, f.x), f.y);
}

float ivnoise3(float3 p)
{
    float3 i = floor(p);
    float3 f = frac(p);
    f = f * f * (3.0 - 2.0 * f);
    int3 ii = int3(i);
    float n000 = ihash13(ii);
    float n100 = ihash13(ii + int3(1, 0, 0));
    float n010 = ihash13(ii + int3(0, 1, 0));
    float n110 = ihash13(ii + int3(1, 1, 0));
    float n001 = ihash13(ii + int3(0, 0, 1));
    float n101 = ihash13(ii + int3(1, 0, 1));
    float n011 = ihash13(ii + int3(0, 1, 1));
    float n111 = ihash13(ii + int3(1, 1, 1));
    float nx00 = lerp(n000, n100, f.x);
    float nx10 = lerp(n010, n110, f.x);
    float nx01 = lerp(n001, n101, f.x);
    float nx11 = lerp(n011, n111, f.x);
    return lerp(lerp(nx00, nx10, f.y), lerp(nx01, nx11, f.y), f.z);
}

// ---------------------------------------------------------------------------
// 星空（球面等距格点）
// ---------------------------------------------------------------------------

// 单层星点：sph = 球面坐标，cells = 网格密度，gate = 点亮门槛，
// rad = 星点半径（格单位），gain = 整层亮度，seed = 层种子。
float3 starLayer(float2 sph, float t, float cells, float gate, float rad, float gain, float seed)
{
    float2 p = sph * cells;
    float2 cell = floor(p);
    float2 f = frac(p) - 0.5;
    float2 j = hash22(cell + seed) - 0.5;
    float d = length(f - j * 0.8);

    float h  = hash12(cell + 7.77 + seed);
    float h2 = hash12(cell + 3.13 + seed);

    float mag = pow(h2, 1.6);   // 星等分布：多数暗、少数亮
    float star = (1.0 - smoothstep(0.0, rad, d)) * step(gate, h);
    star *= 0.40 + 0.90 * mag;

    float twinkle = 0.80 + 0.20 * sin(t * (1.2 + h2 * 2.6) + h * 60.0);
    float3 tint = lerp(float3(0.70, 0.80, 1.00), float3(1.00, 0.87, 0.70), h2);
    return tint * star * twinkle * gain;
}

// 两层星场：疏而亮的主星 + 密而暗的细星，叠出星等层次，整体更密更亮。
float3 starField(float3 dir)
{
    float2 sph = float2(atan2(dir.z, dir.x), asin(clamp(dir.y, -1.0, 1.0)));
    return starLayer(sph, Time.x, 150.0, 0.78, 0.115, 1.00, 0.0)
         + starLayer(sph, Time.x, 320.0, 0.55, 0.070, 0.40, 19.7);
}

// ---------------------------------------------------------------------------
// 末地银河：移植 Helian-MMCO（Sundial Lite）的 endStars()
// 原出处 shadertoy stBcW1 "Stars and galaxy"（CC0）。
//
// 球面等距网格：每层把 (极角, 方位角) 切成大小不一的格子，
// 每格用哈希决定一颗星的位置 / 亮度，指数衰减形成锐利星点；
// 极角越小（越靠近赤道平面）可通过 gate 的星星越多，于是连成一条银河带。
// ---------------------------------------------------------------------------

float2 galaxyHash2(float2 p)
{
    p = float2(dot(p, float2(127.1, 311.7)), dot(p, float2(269.5, 183.3)));
    return frac(sin(p) * 43758.5453123);
}

// 把 p 折回格心附近（p 原地更新为格内坐标），返回格子编号
float2 galaxyMod2(inout float2 p, float2 size)
{
    float2 c = floor(p / size + 0.5);
    p = p - c * size;
    return c;
}

float endGalaxy(float3 rd, float amount)
{
    // rd.xzy 的球面坐标 = 以世界 Y 轴为极轴：(极角, 方位角)
    float2 sp = float2(acos(clamp(rd.y, -1.0, 1.0)), atan2(rd.z, rd.x));
    float col = 0.0;

    const float m = 2.0;
    float denom = max(m - saturate(amount), 0.35);

    for (float i = 0.0; i < m; ++i)
    {
        float2 pp = sp + 0.5 * i;
        float s = i / denom;
        float2 dim = lerp(0.05, 0.003, s) * 3.1415926;
        float2 np = galaxyMod2(pp, dim);
        float2 h = galaxyHash2(np + 127.0 + i);
        float2 o = -1.0 + 2.0 * h;
        float y = sin(sp.x);
        pp += o * dim * 0.5;
        pp.y *= y;
        float l = length(pp);

        float h2v = frac(h.x * 1887.0);
        float h3 = frac(h.x * 2997.0);
        float scol = lerp(8.0 * h2v, 0.25 * h2v * h2v, s);
        float ccol = col + exp(-(6000.0 / lerp(2.0, 0.25, s)) * max(l - 0.001, 0.0)) * scol;
        col = h3 < y ? ccol : col;
    }

    return 3.0 * col;
}

// ---------------------------------------------------------------------------
// 体积云：移植 Helian-MMCO v1.2.0 (Sundial Lite edit) 的 CLOUD_TYPE 2
// realisticCloud —— 千米尺度球壳积云
//
// 照搬的结构：地球半径 6371 km 的球壳云层，6 octave 值噪声密度场、
// “日月双光路 x 5 样本 x 3 octave”自遮蔽光学深度、自带 16-bit 透射率 LUT
// 提供的大气斜射消光与地面吸收项（低太阳时的暖色云顶）。
//
// B 项改造：原版云底 4.2 km 太高，走路几乎看不出视差（天空像贴在头上）。
// 现在云底固定在世界 y=800（云顶 ~2.5 km），整套云层厚度/层距/采样步长
// 按 HC_CLOUD_SCALE_DOWN 等比缩小；噪声坐标反向放大同样的倍数，云块在
// 屏幕上的角尺寸基本不变，但走/飞时的平移视差会明显出现。
//
// 云块大小滑条（O_CLOUD_SIZE，默认 0.33）：同时缩放基底 2D 噪声与主导形状的
// 前两层 3D octave，让云团从 ~4 km 缩到 ~1.3 km；第 3~4 层保持原频率——
// 最细一层已经接近采样步长，再放大只会变成噪点/闪烁。拉回 1.0 就是原来的大云板。
//
// 框架差异处理：
//   * noisetex 纹理噪声 -> 整数格哈希值噪声（大坐标稳定，按 1:64 格距等价替换）；
//   * AtmosphereTransmittance.bin -> 33x65 降采样内嵌表 + 双线性插值；
//   * 亮度走 HC_LIGHT_SCALE 对齐自有调色管线的数值区间（参考管线走 AgX 自动曝光）。
// ---------------------------------------------------------------------------

#define HC_EARTH_R            6371000.0
// 云底固定世界高度（格）。想再调高/调低只改这一个数：整套云层厚度、
// 采样尺度、消光系数和风速补偿都会按 4200/HC_HEIGHT 自动重标。
#define HC_HEIGHT             800.0
// 4200 / 800：云底高度与全部纵向尺度共用的缩小倍数。
#define HC_CLOUD_SCALE_DOWN   (4200.0 / HC_HEIGHT)
#define HC_THICKNESS          (9000.0 / HC_CLOUD_SCALE_DOWN)
#define HC_CENTER_THICKNESS   (1800.0 / HC_CLOUD_SCALE_DOWN)
#define HC_CENTER_Y           (HC_EARTH_R + HC_HEIGHT + 500.0)
#define HC_BOTTOM             (HC_CENTER_Y)
#define HC_TOP                (HC_EARTH_R + HC_HEIGHT + HC_THICKNESS + 500.0)
#define HC_THICKNESS_MC       (HC_THICKNESS - HC_CENTER_THICKNESS)
#define HC_OCTAVE_SCALE       3.0
#define HC_OCTAVE_FADE        0.5
#define HC_HARDNESS           0.2
// 消光系数与步长同步反向缩放，光学厚度（云的不透明度）保持不变。
#define HC_SAMPLE_DENSITY     (0.02 * HC_CLOUD_SCALE_DOWN)
#define HC_SHADOW_STEP        (540.0 / HC_CLOUD_SCALE_DOWN)
// 70000 是按 4.2 km 云底调的；云底降到 800 后按地平线距离重标，保证远云
// 仍然是“淡出”而不是在低空突然断掉。
#define HC_FADE_DISTANCE      30000.0
#define HC_BASIC_SHADOWLIGHT  0.01
// 参考管线的环境光来自它自己的 HDR 天空（数值远高于我们 0-1 的天空渐变），
// 照抄 0.1 会让云底只剩 ~0.05 亮度，看上去就是一坨黑烟；0.18 加上采样处
// 把环境光放大 4 倍后，云底才回到“灰白阴天”该有的亮度。
#define HC_BASIC_SKYLIGHT     0.18
#define HC_LIGHT_SCALE        2.0
// 形状 octave 用 4（参考为 6）：第 5~6 层特征只有几十米，在当前步进尺度下
// 采不到，只会往云边撒白噪点；第 4 层贡献 6.7%，给云边添一点起伏，缓解
// “像加了模糊滤镜”的观感。4 层权重和恰为 0.9375。
#define HC_DENSITY_WEIGHTS    0.9375
#define HC_SHADOW_WEIGHTS     0.9375
// 平面云层不再靠球壳距离制造“远景”，风速直接按世界格/秒给：
// 默认档约 15 格/秒，云块 470 格时约半分钟换一个形状；嫌快可调低滑条。
#define HC_CLOUD_SPEED        (max(O_CLOUD_SPEED, 0.0) * 8.0 / HC_CLOUD_SCALE_DOWN)
#define HC_CLOUD_AMOUNT       (lerp(0.35, 1.55, saturate(O_CLOUD_COVER)))

